    "Use the slider to set a rate from 0% to 100%. Move it all the way to 100% to unlock a custom value above that range." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el control deslizante para establecer una tasa del 0% al 100%. Muévelo hasta el 100% para desbloquear un valor personalizado por encima de ese rango."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用滑块将税率设置在 0% 到 100% 之间。将其拖到 100% 可解锁超出该范围的自定义值。"
