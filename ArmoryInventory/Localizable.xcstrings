    "Parts cover major firearm components you install, swap, or keep on hand, such as barrels, triggers, receivers, recoil systems, and other internal assemblies." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las piezas abarcan componentes principales de armas de fuego que instalas, intercambias o mantienes disponibles, como cañones, disparadores, cajones de mecanismos, sistemas de retroceso y otros conjuntos internos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零件涵盖你会安装、更换或备存的主要枪械组件，例如枪管、扳机、机匣、后坐系统及其他内部总成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零件涵蓋你會安裝、更換或備存的主要槍械組件，例如槍管、扳機、機匣、後座系統及其他內部總成。"
          }
        }
      }
    },
